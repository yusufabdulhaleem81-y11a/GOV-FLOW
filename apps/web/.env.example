# Supabase project (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Leave empty in development — the Vite dev server proxies /api to the local API.
# In production, set the absolute API base, e.g. https://api.govflow.example.com
VITE_API_URL=
