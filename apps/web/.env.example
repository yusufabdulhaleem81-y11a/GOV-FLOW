# Supabase project URL from Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase anon/public key from Project Settings → API (never use the service_role key here).
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY
# API base URL from the Render service; include `/api/v1`. Leave empty locally to use the Vite proxy.
VITE_API_URL=
