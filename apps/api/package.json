{
  "name": "@govflow/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --external:@supabase/supabase-js --external:fastify --external:@fastify/cors --external:@fastify/helmet --external:@fastify/rate-limit --external:zod --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "cross-env NODE_ENV=production node dist/index.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@govflow/types": "*",
    "@govflow/validation": "*",
    "@supabase/supabase-js": "^2.47.10",
    "fastify": "^5.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "cross-env": "^7.0.3",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^2.1.8"
  }
}
