# Copy to `.env.local` at the repository root. Use placeholders here; never commit real secrets.
# Supabase project URL from Project Settings → API.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase anon/public key from Project Settings → API.
SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY
# Supabase service_role key from Project Settings → API; keep server-side only.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNycWFqcWpzcnNnZmZ6aXNjeWVuIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MTM4MDYwNiwiZXhwIjoyMTA2OTU2NjA2fQ.duS1s1RmXQMorRtIhlANFOgw6XeBTpE5I8Jb5PpCKbY
# Supabase Postgres URI from Project Settings → Database → Connection string (Session pooler).
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@YOUR-PROJECT-REF.pooler.supabase.com:5432/postgres
# API listen port; local default is 4000 and Render provides its own PORT.
PORT=4000
# Browser origin(s) allowed by API CORS; replace with the deployed Netlify site URL in Render.
WEB_ORIGIN=http://localhost:5173
# API runtime mode; set to production on Render.
NODE_ENV=development
# Optional Resend API key from the Resend dashboard for sending real email.
RESEND_API_KEY=YOUR-RESEND-API-KEY
# Optional verified sender identity configured in Resend.
EMAIL_FROM=YOUR-VERIFIED-SENDER
