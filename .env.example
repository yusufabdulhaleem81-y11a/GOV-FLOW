# ──────────────────────────────────────────────────────────────────────────────
# GovFlow environment configuration
# Copy this file to `.env.local` (root) and fill in the values.
# The web app additionally reads VITE_* variables (see apps/web/.env.example).
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ───────────────────────────────────────────────────────
# Project URL            → Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# anon / public key (safe to expose, protected by RLS)
SUPABASE_ANON_KEY=eyJ...
# service_role key (SERVER ONLY — never expose to the browser or commit it)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Database (required for `npm run db:migrate`) ─────────────────────────────
# Supabase Dashboard → Project Settings → Database → Connection string (URI).
# Use the "Session pooler" connection string (port 5432).
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# ── API server ───────────────────────────────────────────────────────────────
PORT=4000
# Comma-separated list of allowed browser origins (CORS)
WEB_ORIGIN=http://localhost:5173
# Node environment: development | test | production
NODE_ENV=development

# ── Email notifications (optional) ───────────────────────────────────────────
# If RESEND_API_KEY is not set, GovFlow runs in development notification mode:
# notifications are stored in the database and printed to the API console.
# https://resend.com — free tier available.
RESEND_API_KEY=
# Verified sender, e.g. "GovFlow <govflow@yourdomain.com>"
EMAIL_FROM=
